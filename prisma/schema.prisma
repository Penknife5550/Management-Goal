// ============================================================
// Prisma-Schema - CREDO Fuehrungs-Cockpit (Goal/WIG-Modul)
// Datenmodell der strategischen Ebene nach PLAN.md Abschnitt 2.
// Scope ab Tag 1: ownerId / rechtseinheitId (RBAC-Durchsetzung folgt spaeter).
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GoalStatus {
  BACKLOG
  FOKUS // aktive WIG (Wildly Important Goal)
  ERREICHT
  ARCHIVIERT
}

enum Ampel {
  GRUEN
  GELB
  ROT
}

enum TaskStatus {
  TODO
  DOING
  DONE
}

enum EnrichmentSource {
  USER
  AI_OLLAMA
  AI_CLOUD
}

// Rechtseinheit = eine der Einrichtungen (hier nur Stammtabelle fuer den Scope).
model Rechtseinheit {
  id      String  @id @default(cuid())
  name    String
  kuerzel String?
  goals   Goal[]

  @@map("rechtseinheit")
}

// Minimaler Nutzer fuer den Owner-Scope (Nutzerverwaltung kommt in Phase 4).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  goals     Goal[]   @relation("Owner")
  tasks     Task[]   @relation("TaskOwner")
  createdAt DateTime @default(now())

  // Consent fuer Reminder-Mails (Phase 2: nutzergesteuert, kein Spam).
  // Pro-User-Schalter; eine eigene Profil-UI folgt mit der Nutzerverwaltung (Phase 4).
  emailRemindersEnabled Boolean @default(true)

  @@map("user")
}

model Goal {
  id          String     @id @default(cuid())
  titel       String
  outcome     String? // Drucker: angestrebter Beitrag (Pflicht bei FOKUS)
  status      GoalStatus @default(BACKLOG)
  ampel       Ampel      @default(GELB)
  fortschritt Int        @default(0) // Lag-Gesamtfortschritt 0-100
  dueDate     DateTime?
  abhaengig   Boolean    @default(false) // Hebel-Tag: selbst umsetzbar vs. abhaengig

  // Zeitpunkt des letzten Wochen-Check-ins. Ehrliches Signal fuer die
  // Reminder-Logik (FOKUS-WIG ohne Check-in > 7 Tage). null = noch nie;
  // dann gilt createdAt als Bezugspunkt (siehe lib/reminders.ts).
  lastCheckinAt DateTime?

  // Scope ab Tag 1
  ownerId         String
  owner           User          @relation("Owner", fields: [ownerId], references: [id])
  rechtseinheitId String
  rechtseinheit   Rechtseinheit @relation(fields: [rechtseinheitId], references: [id])

  // MBO-Kaskade Org -> Bereich -> Person
  parentGoalId String?
  parentGoal   Goal?   @relation("Kaskade", fields: [parentGoalId], references: [id])
  childGoals   Goal[]  @relation("Kaskade")

  zugewiesenVon String? // zentral zugewiesen durch (Phase 5)

  tasks        Task[]
  leadMeasures LeadMeasure[]
  learningLog  LearningLog?
  checkIns     CheckIn[]
  q2Blocks     Q2Block[]

  // KI-Anreicherung: Felder vorgesehen, in diesem Slice NICHT verdrahtet
  aiVorschlag  Json?
  aiConfidence Float?
  aiEnrichedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId, status])
  @@index([rechtseinheitId, status])
  @@map("goal")
}

// 4DX: steuerbarer Fruehindikator je WIG.
model LeadMeasure {
  id           String @id @default(cuid())
  goalId       String
  goal         Goal   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  beschreibung String
  zielwert     Int
  istwert      Int    @default(0)

  @@index([goalId])
  @@map("lead_measure")
}

// Drucker: Feedback-Analyse (erwartet vs. tatsaechlich). Volle Auswertung = Phase 7.
model LearningLog {
  id           String    @id @default(cuid())
  goalId       String    @unique
  goal         Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  erwartet     String
  tatsaechlich String?
  reviewAm     DateTime?

  @@map("learning_log")
}

// Aufgaben-Ebene (Eisenhower). Owner-Scope ab Tag 1 wie bei Goal.
// Die ai*-Felder werden vom KI-Eisenhower (Phase 2, Schritt 5) gestaged,
// ueberschreiben aber nie die manuellen important/urgent des Nutzers.
model Task {
  id                   String           @id @default(cuid())
  ownerId              String
  owner                User             @relation("TaskOwner", fields: [ownerId], references: [id])
  goalId               String?
  goal                 Goal?            @relation(fields: [goalId], references: [id], onDelete: SetNull)
  titel                String
  status               TaskStatus       @default(TODO)
  position             Float            @default(0)
  important            Boolean          @default(false)
  urgent               Boolean          @default(false)
  dueDate              DateTime?
  zeitGeplantMin       Int?
  zeitIstMin           Int?
  aiQuadrantSuggestion Int?
  aiConfidence         Float?
  aiReasoning          String?
  lastModifiedBy       EnrichmentSource @default(USER)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([ownerId, status])
  @@index([goalId, status])
  @@map("task")
}

// ============================================================
// Mail / Notifications (Phase 2) — eigener SMTP-Versand statt n8n.
// Pattern uebernommen aus dem CREDO HR-Portal, auf das Cockpit eingedampft.
// ============================================================

// SMTP-Konfiguration als Singleton (id = "default").
// Passwort liegt AES-256-GCM-verschluesselt (lib/encryption.ts).
model SmtpConfig {
  id           String   @id @default("default")
  host         String   @default("")
  port         Int      @default(587)
  secure       Boolean  @default(false) // true = Port 465 (SSL), false = STARTTLS
  username     String   @default("")
  password     String   @default("") // verschluesselt; im Frontend nur maskiert
  fromEmail    String   @default("")
  fromName     String   @default("CREDO Fuehrungs-Cockpit")
  replyToEmail String   @default("") // leer = kein Reply-To
  isActive     Boolean  @default(false) // muss nach Einrichtung aktiviert werden
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("smtp_config")
}

// E-Mail-Vorlage je Event (editierbar im Einstellungs-Portal).
// Fehlt eine DB-Vorlage, greift der Code-Default (lib/default-email-templates.ts).
model EmailTemplate {
  id        String  @id @default(cuid())
  event     String  @unique // korrespondiert mit dem Event-Katalog (lib/email-events.ts)
  name      String
  subject   String
  bodyHtml  String
  bodyText  String?
  variables Json // [{ key, description }]
  // Empfaenger: kommagetrennt, variablen-faehig. Leer = Katalog-Default.
  recipientTo      String  @default("")
  recipientCc      String  @default("")
  recipientBcc     String  @default("")
  recipientReplyTo String  @default("")
  isActive         Boolean @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("email_template")
}

// Versandprotokoll: jeder Versuch (Zustellnachweis + Fehlerdiagnose).
// Hinweis: enthaelt Empfaenger-Adressen (personenbezogen) — Retention klaeren.
model EmailLog {
  id        String   @id @default(cuid())
  event     String
  recipient String   @default("")
  cc        String?
  bcc       String?
  subject   String   @default("")
  status    String // "SENT" | "FAILED" | "SKIPPED"
  detail    String?
  messageId String? // SMTP-Message-ID als Zustellnachweis
  isTest    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([event])
  @@index([status])
  @@index([createdAt])
  @@map("email_log")
}

// Generischer Key-Value-Speicher fuer App-weite Schalter
// (z.B. globaler Reminder-Kill-Switch: key = "remindersGloballyEnabled").
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_setting")
}

// Q2-Schutz (Covey/Drucker): woechentlich wiederkehrender Zeitblock fuer
// "wichtig, nicht dringend" — die aktive Arbeit an den WIGs. Optional einer WIG
// zugeordnet. Exportierbar als ICS (woechentliche Wiederholung).
model Q2Block {
  id          String   @id @default(cuid())
  ownerId     String
  titel       String
  wochentag   Int // ISO: 1=Mo … 7=So
  startMinute Int // Minuten ab Mitternacht (0–1439), lokale Zeit (Europe/Berlin)
  dauerMin    Int      @default(60)
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@map("q2_block")
}

// Check-in-Historie: pro Wochen-Check-in EIN Snapshot je WIG (Ampel + Fortschritt
// zum Zeitpunkt des Check-ins). sessionId gruppiert die WIGs eines Durchlaufs;
// so lassen sich sowohl Sessions ("wann eingecheckt") als auch Trends je WIG
// ("Ampel-Verlauf") auswerten (Adoptions-KPIs, Phase 3).
model CheckIn {
  id          String   @id @default(cuid())
  sessionId   String // gruppiert die WIGs eines Durchlaufs
  ownerId     String
  goalId      String
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  ampel       Ampel
  fortschritt Int
  createdAt   DateTime @default(now())

  @@index([goalId, createdAt])
  @@index([ownerId, sessionId])
  @@map("check_in")
}

// Reservierung je Empfaenger/Event/Periode — macht den Reminder-Versand
// idempotent OHNE Race: vor dem Versand wird hier ein Eintrag angelegt; der
// Unique-Constraint laesst keinen zweiten Versand derselben Periode zu, auch
// bei parallelen Cron-Triggern. periodKey = ISO-Kalenderwoche (z.B. "2026-W27").
model ReminderDispatch {
  id        String   @id @default(cuid())
  recipient String
  event     String
  periodKey String
  createdAt DateTime @default(now())

  @@unique([recipient, event, periodKey])
  @@index([createdAt]) // fuer Retention-Cleanup (where createdAt < cutoff)
  @@map("reminder_dispatch")
}

// Idempotenz-Sperre fuer eingehende Webhook-Callbacks (KI-Eisenhower, Schritt 5).
// jobKey = deterministischer Content-Hash (taskId + Titel). Der Unique-Constraint
// laesst einen zweiten Callback mit gleichem jobKey nicht durch (n8n-Retries,
// Doppel-Zustellung). Schicht 2 des KI-Loop-Schutzes (PLAN §5).
model WebhookIdempotency {
  id        String   @id @default(cuid())
  jobKey    String   @unique
  createdAt DateTime @default(now())

  @@index([createdAt]) // fuer Retention-Cleanup (where createdAt < cutoff)
  @@map("webhook_idempotency")
}
