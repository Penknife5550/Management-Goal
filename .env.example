# PostgreSQL-Verbindung (lokal via docker-compose: Host "db", Port 5432)
DATABASE_URL="postgresql://credo:credo_dev_2026@localhost:5433/cockpit?schema=public"

# Innerhalb des docker-compose-Netzwerks nutzt die App diesen Wert:
# DATABASE_URL="postgresql://credo:credo_dev_2026@db:5432/cockpit?schema=public"

# ------------------------------------------------------------
# Mail / Notifications (Phase 2)
# ------------------------------------------------------------
# Verschluesselt das in der DB gespeicherte SMTP-Passwort (AES-256-GCM).
# 64-stelliger Hex-String:  openssl rand -hex 32
# WICHTIG: Ohne diesen Key kann KEIN SMTP-Passwort gespeichert werden.
ENCRYPTION_KEY="a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6"

# Schuetzt die Cron-Route /api/cron/reminders (Header: Authorization: Bearer ...).
# openssl rand -hex 24
CRON_SECRET="cron-dev-secret-2026"

# ------------------------------------------------------------
# Auth (AP6)
# ------------------------------------------------------------
# Hinweis: Das fruehere ADMIN_TOKEN ist DEPRECATED — durch echte Rollen (AP6) ersetzt.

# Signiert die Session-JWTs (Cookie "cockpit_session"). In Produktion zwingend
# ein starkes Secret setzen (min. 32 Zeichen):  openssl rand -hex 32
JWT_SECRET=""

# Initial-Passwort des geseedeten Admin-Kontos (npx prisma db seed). In Produktion
# zwingend setzen und nach dem ersten Login aendern; ohne diesen Wert greift im
# Seed nur ein Dev-Fallback (mit Warnung im Seed-Log).
ADMIN_INITIAL_PASSWORD=""

# Dev-Schutz: "1" = es wird KEINE echte Mail versendet, der Inhalt landet nur
# im Server-Log (nodemailer jsonTransport). In Produktion NICHT setzen.
MAIL_DRY_RUN="1"

# Basis-URL der App — fuer Links in E-Mails (z.B. CTA der Reminder-Mail).
APP_URL="http://localhost:3000"

# Relay-Schutz: kommagetrennte Liste erlaubter Empfaenger-Domains. Leer/ungesetzt
# = keine Einschraenkung (Dev). In Produktion auf die eigenen Domains setzen,
# damit das System nicht als Spam-/Phishing-Relay missbraucht werden kann.
# Beispiel: MAIL_ALLOWED_DOMAINS="credo-gruppe.de,fes-minden.de"
MAIL_ALLOWED_DOMAINS=""

# SMTP-Zugangsdaten werden NICHT hier gesetzt, sondern in der App unter
# Einstellungen -> SMTP gepflegt (liegen in der DB, Passwort verschluesselt).

# ------------------------------------------------------------
# KI-Eisenhower (Phase 2, Schritt 5) — async ueber n8n + lokales Ollama
# ------------------------------------------------------------
# Inbound-Webhook des n8n-Workflows. Das Cockpit ruft NUR diesen Webhook, nie
# Ollama direkt. Der Workflow nimmt { taskId, titel, model, callbackUrl, jobKey,
# callbackSecret }, ruft ein LOKALES Modell (NIE ein :cloud-Modell — PII!) mit
# format:"json" und postet das Ergebnis an callbackUrl (Header x-ai-callback-secret).
N8N_EISENHOWER_WEBHOOK_URL=""

# Schuetzt den Rueckkanal /api/ai/callback. Das Cockpit sendet dieses Secret im
# Trigger mit (callbackSecret); n8n gibt es im Callback-Header zurueck.
# openssl rand -hex 24
AI_CALLBACK_SECRET=""

# Lokales Ollama-Modell fuer die Klassifizierung (wird im Trigger an n8n mitgegeben).
AI_MODEL="qwen2.5:7b"

# KI-Veredelung des Montags-Briefings (AP3, OPTIONAL). Synchroner Webhook: das
# Cockpit schickt { model, prompt } und bekommt { text } zurueck (n8n-Workflow
# ki-briefing.workflow.json). Leer/ungesetzt = deterministisches Briefing (Fallback).
# Nutzt AI_MODEL (dasselbe LOKALE Modell, NIE :cloud - Ziel-Titel sind interne Daten).
N8N_BRIEFING_WEBHOOK_URL=""
